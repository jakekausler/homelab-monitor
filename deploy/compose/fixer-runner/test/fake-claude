#!/bin/sh
# Fake `claude` CLI used by the fixer-runner image when built with
# --build-arg CLAUDE_BINARY_SOURCE=fake. NOT installed in real images.
#
# Purpose (STAGE-009-003 integration test harness):
#   - Prove the non-interactive exec shape works (stdin drained, argv captured).
#   - Prove the RW transcript bind-mount is writable BY THE homelab-fixer user.
#   - Prove written files are owned by HM_FIXER_UID:HM_FIXER_GID (default ACL +
#     the in-image USER homelab-fixer identity).
#   - Optionally hang (FAKE_CLAUDE_SLEEP) so the `docker kill` test has an
#     in-flight exec to terminate.
#
# It writes into the transcript dir mounted at /data/runbook-transcripts.
set -eu

TRANSCRIPT_DIR="${FAKE_CLAUDE_TRANSCRIPT_DIR:-/data/runbook-transcripts}"
PREFIX="fake-claude-$$"

# (1) Drain stdin to EOF so `< /dev/null` (or any piped stdin) never blocks.
cat >/dev/null || true

# (2) Record argv (one arg per line) so the test can assert -p / folder /
#     --dangerously-skip-permissions were passed through.
ARGS_FILE="${TRANSCRIPT_DIR}/${PREFIX}.args"
: >"${ARGS_FILE}"
for a in "$@"; do
    printf '%s\n' "$a" >>"${ARGS_FILE}"
done

# (2b) Detect plan-only (dry-run) invocation: `--permission-mode plan`.
#      In plan mode we record a marker and emit a PLAN transcript, and we do
#      NOT simulate execution (no hang, no side effects).
IS_PLAN=0
prev=""
for a in "$@"; do
    if [ "$prev" = "--permission-mode" ] && [ "$a" = "plan" ]; then
        IS_PLAN=1
    fi
    prev="$a"
done

# (4a) STAGE-009-009 feedback sentinel. Two mutually-exclusive envs:
#   FAKE_CLAUDE_FEEDBACK_MALFORMED=1  -> write intentionally-broken JSON
#   FAKE_CLAUDE_FEEDBACK=<json-string> -> write verbatim payload
# Neither set -> no feedback file (default; existing tests unaffected).
FEEDBACK_FILE="${TRANSCRIPT_DIR}/${PREFIX}.feedback.json"
if [ "${FAKE_CLAUDE_FEEDBACK_MALFORMED:-}" = "1" ]; then
    printf 'not valid json{{{' >"${FEEDBACK_FILE}"
elif [ -n "${FAKE_CLAUDE_FEEDBACK:-}" ]; then
    printf '%s' "${FAKE_CLAUDE_FEEDBACK}" >"${FEEDBACK_FILE}"
fi

# (4b) STAGE-009-014 docker-intent sentinel. When FAKE_CLAUDE_DOCKER_INTENT
# is set (a JSON string), write it verbatim to
# <TRANSCRIPT_DIR>/<HM_RUN_ID>/docker-intent.json. The subdir is created
# with mkdir -p. HM_RUN_ID is injected by the orchestrator via exec env.
# If HM_RUN_ID is unset, fall back to the fake-claude PREFIX subdir so
# older test paths still work.
if [ -n "${FAKE_CLAUDE_DOCKER_INTENT:-}" ]; then
    INTENT_RUN_ID="${HM_RUN_ID:-${PREFIX}}"
    INTENT_DIR="${TRANSCRIPT_DIR}/${INTENT_RUN_ID}"
    mkdir -p "${INTENT_DIR}"
    printf '%s' "${FAKE_CLAUDE_DOCKER_INTENT}" >"${INTENT_DIR}/docker-intent.json"
fi

if [ "${IS_PLAN}" = "1" ]; then
    PLAN_MARKER="${TRANSCRIPT_DIR}/${PREFIX}.plan"
    : >"${PLAN_MARKER}"
    PLAN_TRANSCRIPT="${TRANSCRIPT_DIR}/${PREFIX}.transcript"
    {
        printf 'fake-claude PLAN transcript\n'
        printf 'mode=plan\n'
        printf 'timestamp=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        printf 'argv=%s\n' "$*"
        printf 'PLAN: (dry-run) no changes would be made; steps: [simulated]\n'
    } >"${PLAN_TRANSCRIPT}"
    exit 0
fi

# (5) Write a transcript file (proves the RW mount + ownership). Include a
#     timestamp so concurrent invocations don't clobber, and echo the API key
#     PRESENCE (never the value) so the test can assert it is empty under fake.
TRANSCRIPT_FILE="${TRANSCRIPT_DIR}/${PREFIX}.transcript"
{
    printf 'fake-claude transcript\n'
    printf 'timestamp=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'argv=%s\n' "$*"
    if [ -n "${ANTHROPIC_API_KEY:-}" ]; then
        printf 'anthropic_api_key_present=1\n'
    else
        printf 'anthropic_api_key_present=0\n'
    fi
} >"${TRANSCRIPT_FILE}"

# (6) Optional hang for the kill test. Sleep BEFORE exiting.
if [ -n "${FAKE_CLAUDE_SLEEP:-}" ]; then
    sleep "${FAKE_CLAUDE_SLEEP}"
fi

# (7) Success.
exit 0
